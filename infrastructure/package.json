{
  "name": "sample-defense-in-depth-rai-multi-agent",
  "version": "1.0.0",
  "description": "Unified Defense-in-Depth Responsible AI for Multi-Agent Collaboration — Single-agent governance + inter-agent delegation governance",
  "bin": {
    "sample-responsible-ai-multi-agent": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
