    "constructs": "^10.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "22.x",
    "typescript": "~5.6.0",
    "ts-node": "^10.9.0",
    "aws-cdk": "2.1111.0"
  }
}
